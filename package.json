{
  "name": "chathub-desktop",
  "version": "1.1.0",
  "description": "One Windows workspace for YouTube, Twitch and Kick chat",
  "author": "ChatHub",
  "license": "MIT",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node tests/desktop-smoke.cjs",
    "build": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "playwright": "^1.64.1"
  },
  "build": {
    "appId": "com.chathub.desktop",
    "productName": "ChatHub",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSES/**/*",
      "README.md",
      "LICENSE"
    ],
    "asar": true,
    "win": {
      "target": "portable",
      "icon": "assets/chathub.ico",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "ChatHub-1.1.0-Windows-x64.exe"
    }
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1"
  }
}
